<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="false">

    <!-- ELK đã gỡ khỏi dự án: log nghiệp vụ/audit lưu ở bảng system_logs
         trong Postgres (ServiceLogEmitter -> SystemLogPersister); logback
         chỉ còn nhiệm vụ in console. -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level [%thread] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

</configuration>
